
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

  @font-face {
    font-family: 'judul';
    src: url('font/') format('truetype');
}
body {

  background-color: #f6ecd9; /* Krem lembut khas latar web */
  color: #5b3a29;            /* Teks utama coklat elegan */
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.7;
  font-size: 14 px;
  padding: 30px;             /* Mengganti margin 50px agar aman di semua ukuran layar */
}

a { 
  color: #c97b7b; /* Warna Rose */
  text-decoration: none; 
}
a:hover { 
  text-decoration: underline;
  color: #c8963e; /* Mustard saat di-hover */
}

/* ---------- Header & Navigasi Atas ---------- */
.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff8e8;
  padding: 15px 30px;
  border-bottom: 4px double #5b3a29;
  border-radius: 8px;
  margin-bottom: 30px;
  position: relative;
  z-index: 999;
}

.brand {
  font-size: 24px;
  color: #5b3a29;
  font-weight: bold;
  text-decoration: none;
}

.brand i {
  color: #c8963e; /* Mustard */
}

/* Navigasi Menu Atas */
nav {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

nav a {
  display: inline-block;
  padding: 8px 16px;
  border-radius: 99px;
  font-weight: 600;
  text-decoration: none;
  text-transform: capitalize;
  color: #5b3a29;
  background-color: #efe0c2;
  transition: all 0.3s ease;
  cursor: pointer;
}

nav a:hover { 
  background: #c8963e; /* Mustard */
  color: #fff8e8;
  text-decoration: none;
}

nav a.active, 
nav a[aria-current="page"] {
  background: #c97b7b; /* Rose */
  color: #ffffff;
}

/* ---------- Konten Utama (Main & Section) ---------- */
main {
  background-color: #fff8e8;
  padding: 40px;
  border-radius: 8px;
  border: 1px solid #5b3a29;
  margin-bottom: 30px;
  min-height: 400px; /* Memastikan area konten tidak kolaps/kosong */
}

.page {
  display: block !important; /* Memastikan section selalu tampil secara utuh */
}

/* ---------- Galeri & Foto (250px x 250px, Border, Hover, Opacity) ---------- */
.produk-gambar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
  margin: 25px 0;
}

/* Kotak pembungkus tiap item foto agar teks di bawahnya rapi */
.item-foto, .produk-gambar > div {
  text-align: center;
}

.produk-gambar img {
  width: 250px;             
  height: 250px;           
  object-fit: cover;       
  border-radius: 10px;      
  border: 3px solid #5b3a29;
  outline: 2px solid #c8963e;
  outline-offset: -6px;     
  opacity: 0.8;   
  transition: transform 0.3s ease, opacity 0.3s ease, box-shadow 0.3s ease;
  box-shadow: 0 4px 8px rgba(91, 58, 41, 0.15);
}

.produk-gambar img:hover {
  transform: scale(1.03);   /* Efek memperbesar halus saat di-hover */
  opacity: 1;               /* Gambar menjadi jelas penuh */
  box-shadow: 0 6px 12px rgba(91, 58, 41, 0.25);
}

/* ---------- Banner & Tampilan Utama ---------- */
.header-banner {
  background-color: #7d8f69; /* Sage */
  color: #f6ecd9;
  padding: 30px;
  text-align: center;
  border-radius: 8px;
  margin-bottom: 25px;
  border: 2px solid #5b3a29;
}

.logo-teks {
  font-size: 22px;
  font-weight: bold;
  letter-spacing: 1px;
  display: block;
  margin-bottom: 10px;
}

.judul-utama, .judul-kategori {
  color: #5b3a29;
  margin-bottom: 15px;
}

.deskripsi-utama, .deskripsi-kategori, .kotak-informasi {
  background-color: #fff8e8;
  padding: 15px;
  border-radius: 6px;
  margin-bottom: 20px;
}

/* ---------- Tabel ---------- */
table { 
  border-collapse: collapse; 
  width: 100%;
  background-color: #fff8e8;
  margin: 20px 0;
}

th, td {
  padding: 12px;
  border: 1px solid #5b3a29;
  text-align: left;
}

th {
  background-color: #7d8f69; /* Sage untuk header tabel */
  color: #f6ecd9;
}

ul, ol { 
  margin: 10px 0; 
  padding-left: 20px; 
}


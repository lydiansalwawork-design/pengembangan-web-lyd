/* ==========================================
   PALET WARNA AKADEMI KREATIF
   Krem    : #f6ecd9 | Krem Terang : #fff8e8
   Coklat  : #5b3a29 | Mustard     : #c8963e
   Rose    : #c97b7b | Sage        : #7d8f69
   ========================================== */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

@font-face {
  font-family: 'judul';
  src: url('font/Anak\ Bijak.ttf') format('truetype');
}

body {
  background-color: #f6ecd9;
  color: #5b3a29;
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.7;
  font-size: 15px;
  padding: 30px;
  
}

a { 
  color: #c97b7b;
  text-decoration: none; 
  transition: color 0.3s ease;
}
a:hover { 
  text-decoration: underline;
  color: #c8963e;
}
.header-banner-top {
  background: url('images/melukis.jpg') no-repeat center center/cover;
  border-radius: 8px;
  height: 250px;
  margin-bottom: 15px;
  border: 3px solid #5b3a29;
}

.header-overlay {
  background: rgba(91, 58, 41, 0.65);
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #f6ecd9;
  border-radius: 5px;
}

.main-nav {
  background-color: #fff8e8;
  border-radius: 8px;
  border: 2px solid #5b3a29;
  margin-bottom: 25px;
}

.main-nav ul { list-style: none; display: flex; justify-content: center; }
.main-nav li { position: relative; }
.main-nav a { display: block; padding: 12px 20px; color: #5b3a29; text-decoration: none; font-weight: bold; text-transform: uppercase; }
.main-nav a:hover, .main-nav a.active { background-color: #c97b7b; color: #fff; border-radius: 4px; }

/* ---------- Judul ---------- */
h1 { 
  font-family: 'judul', Georgia, serif;
  color: #5b3a29;                        
  text-align: center;
  padding: 10px 0;                        
  font-size: 32px !important;                 
  margin-bottom: 20px;
  text-shadow: 1px 1px 2px rgba(91, 58, 41, 0.15);
}

h2 {
  font-family: 'judul', Georgia, serif;
  color: #5b3a29;                        
  text-align: left;
  padding: 8px 0;                        
  font-size: 22px !important;                 
  margin-bottom: 15px;
  text-shadow: 1px 1px 2px rgba(91, 58, 41, 0.1);
}

h3 {
  font-family: 'judul', Georgia, serif;
  color: #7d8f69;                        
  text-align: left;
  padding: 5px 0;                        
  font-size: 18px !important;                 
  margin-bottom: 10px;
}

/* ---------- Navigasi Header ---------- */
.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff8e8;
  padding: 15px 30px;
  border-bottom: 4px double #5b3a29;
  border-radius: 8px;
  margin-bottom: 30px;
  box-shadow: 0 2px 5px rgba(91, 58, 41, 0.05);
}

.brand {
  font-size: 24px;
  color: #5b3a29;
  font-weight: bold;
  text-decoration: none;
}

.brand i { color: #c8963e; }

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

nav a {
  display: inline-block;
  padding: 8px 16px;
  border-radius: 99px;
  font-weight: 600;
  text-decoration: none;
  color: #5b3a29;
  background-color: #efe0c2;
  transition: all 0.3s ease;
  cursor: pointer;
}

nav a:hover { 
  background: #c8963e;
  color: #fff8e8;
  text-decoration: none;
}

nav a.active {
  background: #c97b7b;
  color: #ffffff;
}

/* ---------- Main & Section ---------- */
main {
  background-color: #fff8e8;
  padding: 40px;
  border-radius: 8px;
  border: 1px solid #5b3a29;
  margin-bottom: 30px;
  min-height: 400px;
  box-shadow: 0 4px 12px rgba(91, 58, 41, 0.05);
}

.header-banner {
  background-color: #7d8f69;
  color: #f6ecd9;
  padding: 30px;
  text-align: center;
  border-radius: 8px;
  margin-bottom: 25px;
  border: 2px solid #5b3a29;
}

.logo-teks {
  font-size: 22px;
  font-weight: bold;
  letter-spacing: 1px;
  display: block;
  margin-bottom: 10px;
}

.deskripsi-utama, .deskripsi-kategori, .kotak-informasi {
  background-color: #fff8e8;
  padding: 15px;
  border-radius: 6px;
  border: 1px solid #5b3a29;
  margin-bottom: 20px;
}

/* ---------- Gambar & Galeri Estetik ---------- */
.produk-gambar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
  margin: 25px 0;
}

.item-foto { text-align: center; }

.produk-gambar img {
  width: 200px !important;            
  height: 200px !important;           
  object-fit: cover;                  
  border-radius: 10px;                
  border: 3px solid #5b3a29;          
  outline: 2px solid #c8963e;         
  outline-offset: -6px;               
  opacity: 0.75;                      
  transition: all 0.3s ease-in-out;   
  box-shadow: 0 4px 8px rgba(91, 58, 41, 0.15);
}

.produk-gambar img:hover {
  transform: scale(1.03);             
  opacity: 1;                         
  box-shadow: 0 6px 14px rgba(91, 58, 41, 0.25);
  border-color: #c97b7b;              
}
.produk-gambar img.foto-detail, 
ul.kotak-informasi img.foto-detail {
  width: 100px !important;    /* Ubah angka 250px sesuai ukuran yang Anda inginkan (misal: 150px atau 300px) */
  height: auto !important;    /* Menjaga agar proporsi gambar tidak gepeng */
  max-width: 100% !important;
  display: block;
  margin: 10px 0;             /* Memberikan jarak spasi atas dan bawah foto */
}
.produk-gambar img.foto-testimoni {
  width: 500px !important;  /* Ubah angka ini sesuai selera (misal 400px atau 500px) */
  height: auto !important;  /* Auto menjaga agar gambar tidak gepeng */
  max-width: 100% !important;
  object-fit: contain !important;
  outline: none !important; /* Menghilangkan outline kuning jika tidak diperlukan */
}

/* ---------- Tabel ---------- */
table { 
  border-collapse: collapse; 
  width: 100%;
  background-color: #fff8e8;
  margin: 20px 0;
  border-radius: 6px;
  overflow: hidden;
}

th, td {
  padding: 12px;
  border: 1px solid #5b3a29;
  text-align: left;
}

th {
  background-color: #7d8f69;
  color: #f6ecd9;
}

ul, ol { 
  margin: 10px 0; 
  padding-left: 20px; 
}

/* ---------- Form Pemesanan ---------- */
.form {
  width: 100%;
  max-width: 600px;
  margin: 20px auto;
  padding: 30px;
  text-align: left;
  background-color: #f6ecd9;
  border: 3px double #5b3a29;
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(91, 58, 41, 0.08);
}

.form label {
  display: block;
  margin-top: 15px;
  font-weight: bold;
  color: #5b3a29;
}

.form input[type="text"],
.form input[type="tel"],
.form select,
.form textarea {
  width: 100%;
  padding: 10px;
  margin-top: 5px;
  border: 1px solid #5b3a29;
  border-radius: 4px;
  background-color: #fff8e8;
  font-family: inherit;
}

.form input[type="submit"] {
  background-color: #c8963e;
  color: #ffffff;
  padding: 12px 20px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-weight: bold;
  margin-top: 20px;
  width: 100%;
  transition: background-color 0.3s ease;
}

.form input[type="submit"]:hover {
  background-color: #5b3a29;
}

.explore-card {
  background-color: #fff8e8;
  border: 2px solid #5b3a29;
  border-radius: 8px;
  padding: 25px;
  text-align: center;
  margin: 25px 0;
}

/* ---------- Footer ---------- */
.footer {
  background-color: #5b3a29;
  color: #f6ecd9;
  padding: 30px 20px;
  border-radius: 8px;
  margin-top: 40px;
}

.footer h2 { color: #c8963e !important; }

.hak-cipta {
  max-width: 1040px;
  margin: 24px auto 0;
  padding-top: 16px;
  border-top: 1px solid rgba(246, 236, 217, 0.2);
  font-size: 14px;
  text-align: center;
  color: #f6ecd9;
}
/* Pastikan area main dan section selalu tampil dan tidak disembunyikan */
main, .page {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
}

/* ---------- Form Pemesanan ---------- */
.form {
  width: 100%;
  max-width: 600px;
  margin: 20px auto;
  padding: 30px;
  text-align: left;
  background-color: #f6ecd9;
  border: 3px double #5b3a29;
  border-radius: 8px;
}

.form label {
  display: block;
  margin-top: 15px;
  font-weight: bold;
  color: #5b3a29;
}

.form input[type="text"],
.form input[type="tel"],
.form select,
.form textarea {
  width: 100%;
  padding: 10px;
  margin-top: 5px;
  border: 1px solid #5b3a29;
  border-radius: 4px;
  background-color: #fff8e8;
  font-family: inherit;
}

.form input[type="submit"] {
  background-color: #c8963e; /* Mustard */
  color: #ffffff;
  padding: 12px 20px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-weight: bold;
  margin-top: 20px;
  width: 100%;
}

.form input[type="submit"]:hover {
  background-color: #5b3a29;
}

.judul-radio {
  margin-top: 15px;
  font-weight: bold;
}

/* ---------- Footer ---------- */
.footer {
  background-color: #5b3a29; /* Coklat tua */
  color: #f6ecd9;
  padding: 30px 20px;
  border-radius: 8px;
  margin-top: 40px;
}

.footer h2, .footer h4 {
  color: #c8963e; /* Mustard */
}

.kolom-footer p { 
  margin: 10px 0; 
}

.footer a { 
  color: #e8c27a; 
}

.footer a:hover {
  color: #c97b7b;
}

.kontak li { 
  margin-bottom: 6px; 
}

.hak-cipta {
  max-width: 1040px;
  margin: 24px auto 0;
  padding-top: 16px;
  border-top: 1px solid rgba(246, 236, 217, 0.2);
  font-size: 14px;
  text-align: center;
  color: #f6ecd9;
}
